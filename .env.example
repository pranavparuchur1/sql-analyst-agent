# Provider is chosen by the prefix: "openai:<model>" or "anthropic:<model>".
LLM_MODEL=anthropic:claude-sonnet-5-5
# Set the key for whichever provider you picked.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides (defaults shown)
# DB_PATH=data/shop.db
# CHECKPOINT_DB=data/checkpoints.db
# MAX_ATTEMPTS=3
# APPROVAL_JOIN_THRESHOLD=4
# ROW_LIMIT=200
# QUERY_TIMEOUT_S=5
# HISTORY_WINDOW=6
# LLM_TEMPERATURE=0   # leave unset for models that only allow the default
